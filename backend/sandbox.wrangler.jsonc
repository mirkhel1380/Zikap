{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zikap-sandbox",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "directory": "./account-static",
    "binding": "ACCOUNT_ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SERVICE_CATALOG_REQUIRED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zikap-sandbox-orders",
      "database_id": "c5ab7f81-b850-45c3-82cc-bff2451ac5bc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
